{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STACKWISE canonical observation",
  "type": "object",
  "required": [
    "dataset_id", "observation_id", "technology", "measurement_boundary",
    "evidence_grade", "source_license"
  ],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "study_id": {"type": ["string", "null"]},
    "source_file": {"type": ["string", "null"]},
    "observation_id": {"type": "string", "minLength": 1},
    "technology": {"type": "string", "minLength": 1},
    "access_network": {"type": ["string", "null"]},
    "transport_protocol": {"type": ["string", "null"]},
    "application_protocol": {"type": ["string", "null"]},
    "security_mode": {"type": ["string", "null"]},
    "device_model": {"type": ["string", "null"]},
    "radio_module": {"type": ["string", "null"]},
    "firmware_version": {"type": ["string", "null"]},
    "payload_bytes": {"type": ["number", "null"], "minimum": 0},
    "direction": {"type": ["string", "null"]},
    "reporting_interval_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "session_policy": {"type": ["string", "null"]},
    "confirmation_mode": {"type": ["string", "null"]},
    "tx_power_dbm": {"type": ["number", "null"]},
    "rssi_dbm": {"type": ["number", "null"]},
    "snr_db": {"type": ["number", "null"]},
    "rsrp_dbm": {"type": ["number", "null"]},
    "rsrq_db": {"type": ["number", "null"]},
    "sinr_db": {"type": ["number", "null"]},
    "operator": {"type": ["string", "null"]},
    "environment": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "timestamp_utc": {"type": ["string", "null"]},
    "duration_s": {"type": ["number", "null"], "minimum": 0},
    "sample_count": {"type": ["integer", "null"], "minimum": 0},
    "voltage_v": {"type": ["number", "null"], "minimum": 0},
    "current_a": {"type": ["number", "null"]},
    "peak_current_a": {"type": ["number", "null"]},
    "power_w": {"type": ["number", "null"]},
    "mean_power_w": {"type": ["number", "null"]},
    "energy_j": {"type": ["number", "null"], "minimum": 0},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "delivery_success": {"type": ["boolean", "null"]},
    "retries": {"type": ["integer", "null"], "minimum": 0},
    "upper_layer_bytes": {"type": ["number", "null"], "minimum": 0},
    "measurement_boundary": {"type": "string", "minLength": 1},
    "evidence_grade": {"enum": ["A", "B", "C", "D", "TEST_ONLY"]},
    "source_license": {"type": "string", "minLength": 1},
    "source_doi": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STACKWISE end-to-end stack candidate",
  "description": "A graph of placed component instances and explicit interface bindings. This is a structural/feasibility object, not a ranked MCDA alternative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stack_id",
    "name",
    "component_instances",
    "bindings",
    "environment_capabilities",
    "primary_access_instance_id",
    "scientific_status"
  ],
  "properties": {
    "stack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "component_instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "component_id", "placement"],
        "properties": {
          "instance_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
          "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
          "placement": {
            "enum": [
              "device",
              "gateway_edge",
              "access_network",
              "network_service",
              "application_backend",
              "management_backend"
            ]
          },
          "instance_properties": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_instance_id", "to_instance_id", "interface", "relation"],
        "properties": {
          "from_instance_id": {"type": "string", "minLength": 1},
          "to_instance_id": {"type": "string", "minLength": 1},
          "interface": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
          "relation": {
            "enum": ["carries", "secures", "manages", "integrates", "bridges", "terminates"]
          }
        }
      }
    },
    "environment_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"}
    },
    "primary_access_instance_id": {"type": "string", "minLength": 1},
    "scientific_status": {
      "enum": ["contract_fixture", "draft_candidate", "verified_candidate"]
    },
    "notes": {"type": ["string", "null"]}
  }
}

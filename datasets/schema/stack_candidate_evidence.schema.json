{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STACKWISE candidate-stack empirical support record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stack_id",
    "support_class",
    "alignment_ids",
    "full_end_to_end_empirical_support",
    "limitations"
  ],
  "properties": {
    "stack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "support_class": {
      "enum": [
        "partial_stack_context_only",
        "component_direct_boundary_only",
        "no_direct_core_four_alignment"
      ]
    },
    "alignment_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]*$"
      }
    },
    "full_end_to_end_empirical_support": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
